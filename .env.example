# Copie este arquivo para .env na VPS e substitua todos os valores.
# Nunca versione o arquivo .env real.

# Aplicação ETFSP
CF_TURNSTILE_SECRET=troque-pelo-segredo-do-turnstile
PUBLIC_CF_TURNSTILE_SITEKEY=troque-pela-site-key-do-turnstile

# Analytics (o ID é obtido ao cadastrar etfsp.com no Umami)
PUBLIC_UMAMI_URL=https://umami.etfsp.com
PUBLIC_UMAMI_WEBSITE_ID=troque-pelo-website-id

# Umami e PostgreSQL
# Sugestões:
#   openssl rand -hex 24
#   openssl rand -hex 32
UMAMI_DB_PASSWORD=troque-por-uma-senha-hexadecimal
UMAMI_APP_SECRET=troque-por-um-segredo-hexadecimal
