# Exemplo para produção. Copie para .env somente na VPS e substitua os valores.
# Nunca versione o arquivo .env real nem reutilize estes placeholders.

# Estado persistente da aplicação
DB_PATH=/caminho/absoluto/para/db.sqlite3
FOTOS_DIR=/caminho/absoluto/para/Fotos

# Cloudflare Turnstile de produção
CF_TURNSTILE_SECRET=troque-pelo-segredo-do-turnstile
PUBLIC_CF_TURNSTILE_SITEKEY=troque-pela-site-key-do-turnstile

# Analytics opcional (deixe ambos vazios para desabilitar)
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# Serviços do compose de produção
# Sugestões:
#   openssl rand -hex 24
#   openssl rand -hex 32
UMAMI_DB_PASSWORD=troque-por-uma-senha-hexadecimal
UMAMI_APP_SECRET=troque-por-um-segredo-hexadecimal

# Codex Cloud:
# Configure estas duas variáveis diretamente no ambiente publicado.
# Não copie o .env local e não configure segredos de produção.
# DB_PATH=.cloud-data/db.sqlite3
# FOTOS_DIR=.cloud-data/Fotos
